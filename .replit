modules = ["nodejs-20", "python-3.11"]
[agent]
expertMode = true

run = "python3 main.py"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "run"

[[workflows.workflow]]
name = "run"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd week4-starter/ && python3 main.py"

[workflows.workflow.metadata]
outputType = "console"

